VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Site Key pública de Turnstile. La Secret Key se configura solo en Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
# Datos públicos del responsable. Completar antes de publicar las políticas definitivas.
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_OPERATOR_CUIT=
VITE_LEGAL_OPERATOR_ADDRESS=
VITE_PRIVACY_CONTACT_EMAIL=
# Secretos de Cloudinary. No uses el prefijo VITE_: no van al navegador.
# Cloudinary → Settings → API Keys. Después, los mismos nombres en
# Supabase → Edge Functions → Secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
